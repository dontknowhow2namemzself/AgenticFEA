# Secrets -- never commit the real key (only .env.example is tracked)
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Machine-local preview config: it names this machine's interpreter by
# absolute path, which is of no use to anyone else and leaks the home path.
.claude/launch.json

# Generated FEA artifacts (regenerable via run_all.sh).
# Remove this line if you want to track meshes / results / PNGs in git.
out/
# stray SPOOLES/CalculiX scratch file if ccx is ever run from the repo root
spooles.out

# Generated vector index (rebuilt from the knowledge base).
knowledge/chroma/

# Personal design/working notes (Chinese). The reasoning that a reader needs is
# in the README and in the code comments that carry each measured threshold;
# these are the working documents behind them and stay local.
cantilever_mvp_plan.md
plate_with_hole_plan.md

# Trained model weights: 30 MB of binary that git would carry forever, and the
# training run is reproducible (fixed seed, ~25 min). The evidence that matters
# -- per_case.csv / summary.csv / history.json -- IS tracked.
surrogate/runs/**/*.pt
