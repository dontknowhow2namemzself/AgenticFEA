# OpenRouter (OpenAI-compatible) configuration for the LLM agent layers.
# Setup:  cp .env.example .env   then put your real key in .env
# .env is gitignored -- never commit your real key.

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4
# Alternative model: z-ai/glm-5.2
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# Alternative embeddings: openai/text-embedding-3-large, qwen/qwen3-embedding-8b
